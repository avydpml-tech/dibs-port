[addons]

[addons]

instance_dock/scenes=[  ]

[application]

config/name="DiBS"
config/description="res://Src/Menu/temp/warningScreen.tscn\nres://Src/1_World/1_zones/MainHub/Stage-Mainhub.tscn"
run/main_scene="res://Src/1_World/1_zones/MainHub/Stage-Mainhub.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Deep in Brixen Space\\DiBS"
boot_splash/image="res://Assets/1_Visual/game_icon/DiBS_logo_smaller.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://Assets/1_Visual/game_icon/fox-character-head-64.png"
config/windows_native_icon="res://Assets/1_Visual/game_icon/fox-character-head-256.ico"
config/version="0.8.3"

[aseprite]

animation/layers/exclusion_pattern="_ne$"

[audio]

default_bus_layout="res://zzz_Misc/default_bus_layout.tres"

[autoload]

AnimationManager="*res://Src/_Singletons/AnimationManager.gd"
PosManager="*res://Src/_Singletons/PosManager.gd"
Globals="*res://Src/_Singletons/Globals.gd"
SceneChanger="*res://Src/_Singletons/SceneChanger.tscn"
ScreenManager="*res://Src/_Singletons/ScreenManager.tscn"
CursorManager="*res://Src/_Singletons/CursorManager.gd"
ItemManager="*res://Src/_Singletons/ItemManager.gd"
MenuHandler="*res://Src/_Singletons/MenuHandler.gd"
CreatureManager="*res://Src/_Singletons/EntityManager.gd"
SettingsManager="*res://Src/_Singletons/SettingsManager.gd"
EventManager="*res://Src/_Singletons/EventManager.gd"
Pause="*res://Src/_Singletons/PAUSE.gd"
SoundManager="*res://Src/_Singletons/SoundManager.gd"
ggsManager="*res://addons/GGS/src/ggs_manager.gd"
TitleBar="*res://Src/UI/TitleBar.tscn"
Achievements="*res://Src/_Singletons/Achievements.gd"
Console="*res://addons/quentincaffeino/console/src/Console.tscn"
EndingsManager="*res://Src/_Singletons/EndingsManager.gd"
SaveManager="*res://Src/_Singletons/SaveManager.gd"
EntityManager="*res://Src/_Singletons/EntityManager.gd"
MobileControls="*res://Src/MobileControls/MobileControls.tscn"

[debug]

settings/fps/force_fps=60
gdscript/warnings/enable=false

[display]

window/size/width=1280
window/size/height=720
window/size/borderless=true
window/vsync/use_vsync=false
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/ActionIcon/plugin.cfg", "res://addons/AsepriteWizard/plugin.cfg", "res://addons/GGS/plugin.cfg", "res://addons/InstanceDock/plugin.cfg", "res://addons/SingletonScriptsShortcut/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/imjp94.yafsm/plugin.cfg", "res://addons/nklbdev.parallax/plugin.cfg", "res://addons/quentincaffeino/console/plugin.cfg", "res://addons/vnen.tiled_importer/plugin.cfg" )

